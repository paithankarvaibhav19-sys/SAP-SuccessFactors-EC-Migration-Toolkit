<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE corporate-data-model PUBLIC "-//SuccessFactors, Inc.//DTD CDM 1.0//EN" "corporate-data-model.dtd">
<corporate-data-model>
  <!-- Classic Foundation Object: Location -->
  <foundation-object id="location" type="Location">
    <field id="externalCode" max-length="32" required="true">
      <label>Location Code</label>
    </field>
    <field id="name" max-length="128" required="true">
      <label>Location Name</label>
    </field>
    <field id="description" max-length="256" required="false">
      <label>Description</label>
    </field>
    <field id="status" max-length="1" required="true">
      <label>Status</label>
    </field>
    <field id="timezone" max-length="64" required="false">
      <label>Time Zone</label>
    </field>
    <field id="standard-hours" max-length="10" required="false">
      <label>Standard Weekly Hours</label>
    </field>
  </foundation-object>
</corporate-data-model>